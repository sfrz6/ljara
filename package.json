{
  "name": "ijara",
  "version": "1.0.0",
  "private": true,
  "description": "Ijara: property management platform for Omani letting offices (Functional V1 Validation Environment)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "tsx scripts/migrate.ts --if-configured && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "tsx scripts/migrate.ts && tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "assets": "tsx scripts/generate-assets.ts",
    "check:dashes": "tsx scripts/check-dashes.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@sparticuz/chromium": "^153.0.0",
    "@vercel/blob": "^2.8.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "puppeteer-core": "^25.13.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
