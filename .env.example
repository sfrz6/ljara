# ---------------------------------------------------------------
# Ijara environment variables (Functional V1 Validation Environment)
# Copy to .env.local for local work. Never commit real values.
# ---------------------------------------------------------------

# Postgres connection string. On Vercel use your Neon POOLED connection string:
#   postgres://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# If left empty, Ijara uses an embedded PGlite database stored in ./.data/pglite
# (local development and tests only; never use that on Vercel).
DATABASE_URL=

# Long random string used to sign short lived tokens (file links, gateway tokens).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string

# Public base URL of the deployment (used in absolute links inside messages).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo mode. When true: OTP is fixed (see src/lib/demo.ts), the login screen shows
# the demo account chooser, and simulated gateway controls are visible.
# Must be false in any real production environment.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# File storage driver: "db" (default, files stored in Postgres, works everywhere)
# or "blob" (Vercel Blob, requires BLOB_READ_WRITE_TOKEN).
STORAGE_DRIVER=db
BLOB_READ_WRITE_TOKEN=

# PDF engine. Locally the system Chrome or Edge is used automatically.
# Set CHROME_PATH to override. On Vercel @sparticuz/chromium is used.
CHROME_PATH=

# Protects /api/cron/* endpoints. Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=change-me
